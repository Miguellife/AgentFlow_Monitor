{
  "name": "agentflow-monitor",
  "version": "1.0.0",
  "description": "多平台 AI 用量监控悬浮窗 (DeepSeek / Codex / Kimi / OpenCode)",
  "main": "src/main/bootstrap.js",
  "scripts": {
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "test": "node --test",
    "generate:icons": "node scripts/generate-logo.js",
    "build:win": "npm run generate:icons && npm run build:renderer && electron-builder --win",
    "build:mac": "npm run generate:icons && npm run build:renderer && electron-builder --mac",
    "build:renderer": "npm --prefix renderer run build",
    "dev:renderer": "npm --prefix renderer run dev",
    "start:app": "electron .",
    "start:bg": "node scripts/start-background.js"
  },
  "author": "miguellife",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "echarts": "^5.5.0",
    "electron-store": "^8.1.0",
    "gridstack": "^12.3.3",
    "koffi": "^3.1.4",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^24.9.0"
  },
  "allowScripts": {
    "electron@40.10.3": true,
    "koffi@3.1.4": true
  }
}
